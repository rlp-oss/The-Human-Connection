# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OMEGA_APP_URL: Server-side Omega Protocol Hub URL for Fleet records, contributors, and /pay redirects.
OMEGA_APP_URL="https://human-initiative-omega-799079571356.us-west1.run.app"

# VITE_OMEGA_APP_URL: Client-side Omega Protocol Hub URL for Direct-Rail /pay checkout links.
VITE_OMEGA_APP_URL="https://human-initiative-omega-799079571356.us-west1.run.app"

# OMEGA_GATEWAY_SECRET: Shared HMAC-SHA256 secret used server-side to sign /pay URLs and verify X-Omega-Signature webhooks.
OMEGA_GATEWAY_SECRET="MY_SHARED_OMEGA_GATEWAY_SECRET"

